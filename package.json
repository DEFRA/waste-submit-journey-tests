{
  "name": "waste-submit-journey-tests",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#page-objects/*": "./test/page-objects/*",
    "#components/*": "./test/components/*",
    "#support/*": "./test/support/*"
  },
  "scripts": {
    "clean": "rm -rf allure-results allure-report test-results",
    "test": "npm run clean && playwright test",
    "test:local": "npm run clean && playwright test --headed",
    "test:local:debug": "npm run clean && playwright test --debug",
    "test:compatibility": "npm run clean && browserstack-node-sdk playwright test --config=playwright.compatibility.config.js",
    "install:browsers": "playwright install --with-deps chromium",
    "format": "prettier --write 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "format:check": "prettier --check 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "report": "allure generate allure-results --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "allure-commandline": "2.43.0",
    "allure-playwright": "3.14.0",
    "browserstack-node-sdk": "1.76.0",
    "global-agent": "3.0.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "prettier": "3.9.6"
  }
}
